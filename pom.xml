<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.chatclone</groupId>

    <artifactId>chatclone</artifactId>

    <version>0.0.1-SNAPSHOT</version>

    <name>ChatClone</name>

    <description>Aplicação desktop de chat com JavaFX, MongoDB e IA</description>

    <!-- ========================================== -->
    <!-- CONFIGURAÇÕES DO PROJETO                   -->
    <!-- ========================================== -->

    <properties>

        <!-- Versão do Java utilizada pelo projeto -->
        <maven.compiler.release>25</maven.compiler.release>

        <!-- Codificação dos arquivos -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Versão do JavaFX -->
        <javafx.version>25.0.4</javafx.version>

    </properties>
    
    <dependencyManagement>
    	<dependencies>
        	<!-- Controla versões compatíveis das bibliotecas MongoDB -->
        	<dependency>
            	<groupId>org.mongodb</groupId>
            	<artifactId>mongodb-driver-bom</artifactId>
            	<version>5.12.0</version>
            	<type>pom</type>
            	<scope>import</scope>
        	</dependency>
    	</dependencies>
	</dependencyManagement>

    <!-- ========================================== -->
    <!-- DEPENDÊNCIAS                               -->
    <!-- ========================================== -->

    <dependencies>

        <!-- JavaFX Controls -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JavaFX WebView / WebEngine -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        
        <!-- Driver oficial para conexão com MongoDB -->
		<dependency>
    		<groupId>org.mongodb</groupId>
    		<artifactId>mongodb-driver-sync</artifactId>
		</dependency>
		
		<!-- Permite carregar variáveis do arquivo .env -->
		<dependency>
    		<groupId>io.github.cdimascio</groupId>
    		<artifactId>dotenv-java</artifactId>
    		<version>3.2.0</version>
		</dependency>
		
		<!-- Interpreta o JSON retornado pela API do Groq -->
        <dependency>
    		<groupId>com.fasterxml.jackson.core</groupId>
    		<artifactId>jackson-databind</artifactId>
    		<version>2.20.0</version>
		</dependency>

    </dependencies>
    
     <!-- ========================================== -->
    <!-- PLUGINS DO MAVEN                          -->
    <!-- ========================================== -->

    <build>
        <plugins>

            <!-- Plugin responsável por executar a aplicação JavaFX -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>

                <configuration>
                    <mainClass>br.com.chatclone.Main</mainClass>
                </configuration>

            </plugin>

        </plugins>
    </build>

</project>